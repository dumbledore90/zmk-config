if SHIELD_OYAYUBI_01_LEFT

config ZMK_KEYBOARD_NAME
    default "oyayubi_01"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_OYAYUBI_01_LEFT

if SHIELD_OYAYUBI_01_RIGHT

config EC11
    default y
# EC11_TRIGGER_GLOBAL_THREAD は choice シンボルのため default y は使えない
# ZMK の EC11 Kconfig が default EC11_TRIGGER_GLOBAL_THREAD を持つので不要

endif # SHIELD_OYAYUBI_01_RIGHT

if SHIELD_OYAYUBI_01_LEFT || SHIELD_OYAYUBI_01_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_OYAYUBI_01_LEFT || SHIELD_OYAYUBI_01_RIGHT

// row-gpios は左右でピンが異なるため overlay に移動（設計方針 §2）
// &xiao_d は D11 以降が未定義のため使わず、overlay で &gpio0/&gpio1 直接指定

#include <dt-bindings/zmk/matrix_transform.h>

#include "oyayubi_01-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        // col2row: row = 入力 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
        //          col = 出力 (GPIO_ACTIVE_HIGH)
        wakeup-source;
        // row-gpios / col-gpios は各 overlay で指定
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <15>;  // 左 Col0-6 (7本) + 右 Col0-7 (8本)
        rows = <5>;

        map = <
            // Row0: 左 Col0-4 (5) + 右 Col1-7 (7) = 12
            // 右 Col0 は Row0 に存在しない
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)

            // Row1: 左 Col0-4 (5) + 右 Col1-7 (7) = 12
            // 右 Col0 は Row1 に存在しない
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)

            // Row2: 左 Col0-4 (5) + 右 Col0-7 (8) = 13
            // 右 Col0 (= unified 7) = エンコーダのプッシュスイッチ SW39
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)

            // Row3: 左 Col0-4 (5) + 右 Col0-7 (8) = 13
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)

            // Row4: 左 Col0-6 (7) + 右 Col0-7 (8) = 15
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)
            RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
        >;
    };
};

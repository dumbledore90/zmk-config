// ZMK Studio / DYA Studio 用物理レイアウト定義
//
// 座標換算の根拠:
//   単位: centi-keyunit (ZMK標準)。100 = 1キーユニット = キー1個分の大きさ。
//   ★ mm をそのまま 100 倍してはいけない。キーピッチが 1 単位になるよう割る。
//   スケール: X は 18mm = 100 cku (PCB_X[mm] ÷ 18 × 100)
//             Y は 17mm = 100 cku (PCB_Y[mm] ÷ 17 × 100)
//     → Choc の 18×17mm ピッチがちょうど隙間なく敷き詰まる
//     → キーサイズは w=100 h=100 (正方形表示。実物は 18×17mm だが
//        Studio は配列エディタなので 6% の縦横比差は無視して問題ない)
//   x,y はキャップ左上角。列は 100 刻み、行は 100 刻み、
//   カラムスタガーは 17mm を 100 とした比率で表現される。
//
// 座標元データ: docs/左手_配置座標表.md / docs/右手_配置座標表.md (実測値)
//   左手 Col0-6 → x = 0,100,...,600
//   右手 Col0-7 → x = 761,861,...,1461 (エンコーダ SW39 のみ 756 = 1mm 左)
//
// 検証: 65キー、重なり 0、全体サイズ 15.6u × 5.75u
//
// 配列順: default_transform の map と同じ順 (行ごとに左→右)

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "oyayubi_01";
        transform = <&default_transform>;
        kscan = <&kscan>;

        keys  //                     w     h      x      y   rot   rx   ry
            // ── Row0: 左 Col0-4 + 右 Col1-7 (12 keys) ──────────────────────
            // 左
            = <&key_physical_attrs  100  100     0    68     0    0    0>  // L R0C0  SW1  !
            , <&key_physical_attrs  100  100   100    25     0    0    0>  // L R0C1  SW6  @
            , <&key_physical_attrs  100  100   200     0     0    0    0>  // L R0C2  SW11 #  ← 最上キー
            , <&key_physical_attrs  100  100   300    50     0    0    0>  // L R0C3  SW16 $
            , <&key_physical_attrs  100  100   400    62     0    0    0>  // L R0C4  SW21 %
            // 右 (Col1-7, Col0 は Row0 に存在しない)
            , <&key_physical_attrs  100  100   861    75     0    0    0>  // R R0C1  SW3
            , <&key_physical_attrs  100  100   961    50     0    0    0>  // R R0C2  SW8
            , <&key_physical_attrs  100  100  1061     0     0    0    0>  // R R0C3  SW13 ← 最上キー
            , <&key_physical_attrs  100  100  1161    25     0    0    0>  // R R0C4  SW18
            , <&key_physical_attrs  100  100  1261    75     0    0    0>  // R R0C5  SW23
            , <&key_physical_attrs  100  100  1361    75     0    0    0>  // R R0C6  SW28
            , <&key_physical_attrs  100  100  1461    75     0    0    0>  // R R0C7  SW33

            // ── Row1: 左 Col0-4 + 右 Col1-7 (12 keys) ──────────────────────
            // 左
            , <&key_physical_attrs  100  100     0   168     0    0    0>  // L R1C0  SW2  Q
            , <&key_physical_attrs  100  100   100   125     0    0    0>  // L R1C1  SW7  W
            , <&key_physical_attrs  100  100   200   100     0    0    0>  // L R1C2  SW12 E
            , <&key_physical_attrs  100  100   300   150     0    0    0>  // L R1C3  SW17 R
            , <&key_physical_attrs  100  100   400   162     0    0    0>  // L R1C4  SW22 T
            // 右
            , <&key_physical_attrs  100  100   861   175     0    0    0>  // R R1C1  SW4  Y
            , <&key_physical_attrs  100  100   961   150     0    0    0>  // R R1C2  SW9  U
            , <&key_physical_attrs  100  100  1061   100     0    0    0>  // R R1C3  SW14 I
            , <&key_physical_attrs  100  100  1161   125     0    0    0>  // R R1C4  SW19 O
            , <&key_physical_attrs  100  100  1261   175     0    0    0>  // R R1C5  SW24 P
            , <&key_physical_attrs  100  100  1361   175     0    0    0>  // R R1C6  SW29
            , <&key_physical_attrs  100  100  1461   175     0    0    0>  // R R1C7  SW34

            // ── Row2: 左 Col0-4 + 右 Col0-7 (13 keys) ──────────────────────
            // 左
            , <&key_physical_attrs  100  100     0   268     0    0    0>  // L R2C0  SW3  A
            , <&key_physical_attrs  100  100   100   225     0    0    0>  // L R2C1  SW8  S
            , <&key_physical_attrs  100  100   200   200     0    0    0>  // L R2C2  SW13 D
            , <&key_physical_attrs  100  100   300   250     0    0    0>  // L R2C3  SW18 F
            , <&key_physical_attrs  100  100   400   262     0    0    0>  // L R2C4  SW23 G
            // 右 Col0 = エンコーダプッシュ SW39 (PCB X=-1mm)
            , <&key_physical_attrs  100  100   756   271     0    0    0>  // R R2C0  SW39 ENC_PUSH
            , <&key_physical_attrs  100  100   861   275     0    0    0>  // R R2C1  SW5  H
            , <&key_physical_attrs  100  100   961   250     0    0    0>  // R R2C2  SW10 J
            , <&key_physical_attrs  100  100  1061   200     0    0    0>  // R R2C3  SW15 K
            , <&key_physical_attrs  100  100  1161   225     0    0    0>  // R R2C4  SW20 L
            , <&key_physical_attrs  100  100  1261   275     0    0    0>  // R R2C5  SW25 ;
            , <&key_physical_attrs  100  100  1361   275     0    0    0>  // R R2C6  SW30 '
            , <&key_physical_attrs  100  100  1461   275     0    0    0>  // R R2C7  SW35 \

            // ── Row3: 左 Col0-4 + 右 Col0-7 (13 keys) ──────────────────────
            // 左
            , <&key_physical_attrs  100  100     0   368     0    0    0>  // L R3C0  SW4  Z
            , <&key_physical_attrs  100  100   100   325     0    0    0>  // L R3C1  SW9  X
            , <&key_physical_attrs  100  100   200   300     0    0    0>  // L R3C2  SW14 C
            , <&key_physical_attrs  100  100   300   350     0    0    0>  // L R3C3  SW19 V
            , <&key_physical_attrs  100  100   400   362     0    0    0>  // L R3C4  SW24 B
            // 右
            , <&key_physical_attrs  100  100   761   375     0    0    0>  // R R3C0  SW1
            , <&key_physical_attrs  100  100   861   375     0    0    0>  // R R3C1  SW6  N
            , <&key_physical_attrs  100  100   961   350     0    0    0>  // R R3C2  SW11 M
            , <&key_physical_attrs  100  100  1061   300     0    0    0>  // R R3C3  SW16 ,
            , <&key_physical_attrs  100  100  1161   325     0    0    0>  // R R3C4  SW21 .
            , <&key_physical_attrs  100  100  1261   375     0    0    0>  // R R3C5  SW26 /
            , <&key_physical_attrs  100  100  1361   375     0    0    0>  // R R3C6  SW31
            , <&key_physical_attrs  100  100  1461   375     0    0    0>  // R R3C7  SW36

            // ── Row4: 左 Col0-6 + 右 Col0-7 (15 keys) ──────────────────────
            // 左 (フラット行, Y=80.75 全列共通)
            , <&key_physical_attrs  100  100     0   475     0    0    0>  // L R4C0  SW5  Shift
            , <&key_physical_attrs  100  100   100   475     0    0    0>  // L R4C1  SW10 Ctrl
            , <&key_physical_attrs  100  100   200   475     0    0    0>  // L R4C2  SW15 Alt
            , <&key_physical_attrs  100  100   300   475     0    0    0>  // L R4C3  SW20 GUI
            , <&key_physical_attrs  100  100   400   475     0    0    0>  // L R4C4  SW25 RAlt
            , <&key_physical_attrs  100  100   500   475     0    0    0>  // L R4C5  SW26 Space
            , <&key_physical_attrs  100  100   600   475     0    0    0>  // L R4C6  SW27 (studio_unlock)
            // 右 (フラット行)
            , <&key_physical_attrs  100  100   761   475     0    0    0>  // R R4C0  SW2
            , <&key_physical_attrs  100  100   861   475     0    0    0>  // R R4C1  SW7
            , <&key_physical_attrs  100  100   961   475     0    0    0>  // R R4C2  SW12
            , <&key_physical_attrs  100  100  1061   475     0    0    0>  // R R4C3  SW17
            , <&key_physical_attrs  100  100  1161   475     0    0    0>  // R R4C4  SW22
            , <&key_physical_attrs  100  100  1261   475     0    0    0>  // R R4C5  SW27
            , <&key_physical_attrs  100  100  1361   475     0    0    0>  // R R4C6  SW32
            , <&key_physical_attrs  100  100  1461   475     0    0    0>  // R R4C7  SW37
            ;
    };
};
